# Local development only. Generate independent values; never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://workflow:replace-with-a-local-password@localhost:5432/workflow
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=workflow-local
STORAGE_SECRET_KEY=replace-with-a-local-object-storage-password
STORAGE_BUCKET=credit-documents
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
AI_PROVIDER=local
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Supply temporarily for administrator creation; do not reuse SESSION_SECRET.
BOOTSTRAP_PASSWORD=

# Local HTTP development only; production must use true and HTTPS.
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000

# Override if port 3000 is occupied; update PUBLIC_ORIGIN accordingly.
FRONTEND_PORT=3000
# Azure Blob local development (Azurite); account keys are local-only.
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_KEY=replace-with-base64-encoded-64-random-bytes
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=workflow;AccountKey=replace-with-base64-encoded-64-random-bytes;BlobEndpoint=http://127.0.0.1:10000/workflow;
STORAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# Local Mailpit captures messages; no external email delivery.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_FROM=workflow@localhost
